`timescale 1ns/1ps

module demux1x8_tb;

reg I;
reg S0, S1, S2;
wire Y0, Y1, Y2, Y3, Y4, Y5, Y6, Y7;

demux1x8 uut(
    .I(I),
    .S0(S0),
    .S1(S1),
    .S2(S2),
    .Y0(Y0),
    .Y1(Y1),
    .Y2(Y2),
    .Y3(Y3),
    .Y4(Y4),
    .Y5(Y5),
    .Y6(Y6),
    .Y7(Y7)
);

initial
begin
    $display("Time\tS2 S1 S0\tI\tY7 Y6 Y5 Y4 Y3 Y2 Y1 Y0");

    $monitor("%0t\t%b  %b  %b\t%b\t%b  %b  %b  %b  %b  %b  %b  %b",
             $time,S2,S1,S0,I,Y7,Y6,Y5,Y4,Y3,Y2,Y1,Y0);

    // Test with input = 1
    I = 1;

    S2=0; S1=0; S0=0; #10;
    S2=0; S1=0; S0=1; #10;
    S2=0; S1=1; S0=0; #10;
    S2=0; S1=1; S0=1; #10;
    S2=1; S1=0; S0=0; #10;
    S2=1; S1=0; S0=1; #10;
    S2=1; S1=1; S0=0; #10;
    S2=1; S1=1; S0=1; #10;

    // Test with input = 0
    I = 0;

    S2=0; S1=0; S0=0; #10;
    S2=0; S1=0; S0=1; #10;
    S2=0; S1=1; S0=0; #10;
    S2=0; S1=1; S0=1; #10;
    S2=1; S1=0; S0=0; #10;
    S2=1; S1=0; S0=1; #10;
    S2=1; S1=1; S0=0; #10;
    S2=1; S1=1; S0=1; #10;

    $finish;
end

endmodule
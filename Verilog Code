module demux1x8(
    input I,
    input S0,
    input S1,
    input S2,
    output reg Y0,
    output reg Y1,
    output reg Y2,
    output reg Y3,
    output reg Y4,
    output reg Y5,
    output reg Y6,
    output reg Y7
);

always @(*)
begin
    Y0 = 0;
    Y1 = 0;
    Y2 = 0;
    Y3 = 0;
    Y4 = 0;
    Y5 = 0;
    Y6 = 0;
    Y7 = 0;

    case ({S2,S1,S0})
        3'b000: Y0 = I;
        3'b001: Y1 = I;
        3'b010: Y2 = I;
        3'b011: Y3 = I;
        3'b100: Y4 = I;
        3'b101: Y5 = I;
        3'b110: Y6 = I;
        3'b111: Y7 = I;
    endcase
end

endmodule